---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import ContactSection from "../components/ContactSection.tsx";

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
        {
            "@type": "Question",
            name: "Where is Superior Taekwondo located?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Our dojang is at 94 Mill Road, Helensville 0875, in North West Auckland. Families travel to us from Kumeū, Huapai, Waimauku, Kaukapakapa, Riverhead and Westgate.",
            },
        },
        {
            "@type": "Question",
            name: "Can I try a class before joining?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Yes. Your first class is free. Fill in the form on this page and we'll book you in, or call or text 027 520 1613.",
            },
        },
        {
            "@type": "Question",
            name: "How do I get in touch with Superior Taekwondo?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "You can reach us by phone on 027 520 1613 (Monday–Friday, 9am–5pm) or by email at superiorfitnessnz@gmail.com. For the fastest response, calling directly is recommended.",
            },
        },
        {
            "@type": "Question",
            name: "What information do I need when contacting you about enrolling?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "It helps to know the name and age of the student, any prior martial arts experience, and which days suit you. We'll then recommend the right class and send you the next steps.",
            },
        },
        {
            "@type": "Question",
            name: "Is Superior Taekwondo affiliated with Taekwondo New Zealand?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Yes. Superior Taekwondo is affiliated with Taekwondo New Zealand (TNZ) and World Taekwondo (WT). All belts earned are officially recognised nationally and internationally.",
            },
        },
    ],
};
---

<Layout
    title="Contact Us | Superior Taekwondo"
    description="Book a free trial class at Superior Taekwondo, 94 Mill Road, Helensville. Olympian-led Taekwondo for kids from 4, teens and adults in North West Auckland."
>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}
    ></script>
    <main class="bg-deep-space-black min-h-screen pt-24 pb-12">
        <section id="trial">
            <ContactSection client:load />
        </section>
        <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
    </main>
    <Footer />
</Layout>
