---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import PricingSection from "../components/PricingSection.tsx";

const pricingFaqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
        {
            "@type": "Question",
            name: "How much do Taekwondo classes cost at Superior Taekwondo?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Weekly memberships are $30 a week for one session a week, $40 a week for two sessions a week, or $50 a week for unlimited Taekwondo sessions. Each weekly membership has a one-off $40 sign-up fee. A 10-session concession card is $285 and is valid for 3 months, and your first week is free.",
            },
        },
        {
            "@type": "Question",
            name: "Is there a family discount for multiple family members?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Yes. The first family member pays full price, the second gets 10% off, the third gets 15% off and the fourth gets 20% off.",
            },
        },
        {
            "@type": "Question",
            name: "How does the concession card work?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "The concession card is $285 for 10 sessions and is valid for 3 months. It suits students who can't commit to a weekly membership.",
            },
        },
        {
            "@type": "Question",
            name: "Is there a free trial?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Yes. Your first week is free, and you can attend on any day. Book through the form on our contact page and we'll get you started.",
            },
        },
        {
            "@type": "Question",
            name: "How do I cancel or put my membership on hold?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Cancellations need 21 days' written notice by email, counted from the date we receive your request, and you're welcome to rejoin in a future term, subject to availability. Holds are normally a maximum of 2 to 3 weeks, with longer holds only in exceptional circumstances such as injury, medical reasons or pre-planned holidays. A hold can't cover a whole term, in which case the membership is cancelled.",
            },
        },
        {
            "@type": "Question",
            name: "What if I miss a session?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Training is flexible. You can attend alternative classes on different days when needed, mix and match your training days, and make up a missed session by attending another suitable class that week. The same applies to public holidays and instructor absences, and if an alternative class isn't possible after an instructor absence, you can use your catch-up option the following week.",
            },
        },
        {
            "@type": "Question",
            name: "How is the weekly membership collected?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Weekly memberships are collected via direct debit.",
            },
        },
        {
            "@type": "Question",
            name: "Where do classes take place?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "All training takes place at our Helensville dojang, 94 Mill Road.",
            },
        },
    ],
};

const plans = [
    {
        category: "Weekly memberships",
        options: [
            {
                title: "One session per week",
                frequency: "Ongoing",
                description: "1 session / week",
                sport: "Taekwondo",
                price: "$30.00",
                period: "/ Week",
                signup: "+ $40.00 Sign-up",
            },
            {
                title: "Two sessions per week",
                frequency: "Ongoing",
                description: "2 sessions / week",
                sport: "Taekwondo",
                price: "$40.00",
                period: "/ Week",
                signup: "+ $40.00 Sign-up",
            },
            {
                title: "Unlimited Taekwondo sessions",
                frequency: "Ongoing",
                description: "Unlimited sessions",
                sport: "Taekwondo",
                price: "$50.00",
                period: "/ Week",
                signup: "+ $40.00 Sign-up",
                recommended: true,
            },
        ],
    },
    {
        category: "Other options",
        options: [
            {
                title: "Concession card",
                frequency: "10 sessions",
                description: "10 sessions · valid 3 months",
                sport: "Taekwondo",
                price: "$285.00",
                period: "Total",
                signup: "",
            },
            {
                title: "Free week trial",
                frequency: "1 week",
                description: "1 week · any day",
                sport: "Taekwondo",
                price: "FREE",
                period: "1 week",
                signup: "",
            },
        ],
    },
];

const sellerRef = { "@type": "MartialArtsSchool", name: "Superior Taekwondo" };
const offerUrl = "https://superiortkd.co.nz/pricing/";
const weeklyOffer = (name: string, description: string, price: string) => ({
    "@type": "Offer",
    name,
    description,
    priceSpecification: {
        "@type": "UnitPriceSpecification",
        price,
        priceCurrency: "NZD",
        unitCode: "WEE",
        unitText: "per week",
    },
    url: offerUrl,
    eligibleRegion: "NZ",
    seller: sellerRef,
});

const offersSchema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MartialArtsSchool",
    // Same @id as the global MartialArtsSchool in Layout.astro so Google merges
    // the two nodes into one entity instead of reading a duplicate organisation.
    "@id": "https://superiortkd.co.nz/#organization",
    url: "https://superiortkd.co.nz",
    name: "Superior Taekwondo",
    hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Taekwondo Membership Options",
        itemListElement: [
            weeklyOffer(
                "One session per week (weekly membership)",
                "One Taekwondo session per week at our Helensville dojang. One-off $40 sign-up fee.",
                "30.00",
            ),
            weeklyOffer(
                "Two sessions per week (weekly membership)",
                "Two Taekwondo sessions per week at our Helensville dojang. One-off $40 sign-up fee.",
                "40.00",
            ),
            weeklyOffer(
                "Unlimited Taekwondo sessions (weekly membership)",
                "Unlimited Taekwondo sessions at our Helensville dojang. One-off $40 sign-up fee.",
                "50.00",
            ),
            {
                "@type": "Offer",
                name: "Concession card (10 sessions)",
                description: "10-session concession card valid for 3 months.",
                priceSpecification: {
                    "@type": "PriceSpecification",
                    price: "285.00",
                    priceCurrency: "NZD",
                    description: "10 sessions, valid 3 months",
                },
                url: offerUrl,
                eligibleRegion: "NZ",
                seller: sellerRef,
            },
            {
                "@type": "Offer",
                name: "Free week trial",
                description: "A free one-week trial of Taekwondo, attend on any day.",
                priceSpecification: {
                    "@type": "PriceSpecification",
                    price: "0.00",
                    priceCurrency: "NZD",
                    description: "Free 1-week trial",
                },
                url: offerUrl,
                eligibleRegion: "NZ",
                seller: sellerRef,
            },
        ],
    },
});

const pricingHeadContent = `<script type="application/ld+json">${offersSchema}<\/script>`;

const familyDiscounts = [
    { member: "1st family member", discount: "Full price" },
    { member: "2nd family member", discount: "10% off" },
    { member: "3rd family member", discount: "15% off" },
    { member: "4th family member", discount: "20% off" },
];

const policies = [
    {
        title: "Flexible training",
        text: "Attend alternative classes on different days when needed, mix and match your training days, and make up a missed session by attending another suitable class that week.",
    },
    {
        title: "Public holidays",
        text: "If your usual class falls on a public holiday, attend an alternative class that week to make up the session.",
    },
    {
        title: "Instructor absences",
        text: "If an instructor is away through illness or coaching at a tournament, attend an alternative class that week. If that isn't possible, use your catch-up option the following week.",
    },
    {
        title: "Holds",
        text: "Holds are a maximum of 2 to 3 weeks. Longer holds are only considered in exceptional circumstances such as injury, medical reasons or pre-planned holidays. A hold can't cover a whole term, for availability, location and scheduling reasons, and in that case the membership is cancelled.",
    },
    {
        title: "Cancellations",
        text: "21 days' written notice by email is required, counted from the date we receive your request. You're welcome to rejoin in a future term, subject to availability.",
    },
];
---

<Layout
    title="Pricing & Memberships | Superior Taekwondo"
    	description="Taekwondo pricing in North West Auckland: weekly memberships from $30, a free week trial, and family discounts of 10 to 20% off."
    headContent={pricingHeadContent}
>
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "Service",
                    "serviceType": "Adult Taekwondo Classes",
                    "provider": {
                        "@type": "MartialArtsSchool",
                        "name": "Superior Taekwondo"
                    },
                    "description": "Taekwondo training for adults focusing on self-defense, fitness, STN (Strength to Nurture), and belt progression.",
                    "areaServed": "Helensville"
                },
                {
                    "@type": "Service",
                    "serviceType": "Junior Taekwondo Classes",
                    "provider": {
                        "@type": "MartialArtsSchool",
                        "name": "Superior Taekwondo"
                    },
                    "description": "Martial arts classes for juniors developing discipline, respect, and physical coordination.",
                    "areaServed": "Helensville"
                },
                {
                    "@type": "Service",
                    "serviceType": "Tiny Tigers Classes",
                    "provider": {
                        "@type": "MartialArtsSchool",
                        "name": "Superior Taekwondo"
                    },
                    "description": "Fun and engaging martial arts introduction for young children (ages 4-6).",
                    "areaServed": "Helensville"
                },
                {
                    "@type": "Service",
                    "serviceType": "Fitness Classes",
                    "provider": {
                        "@type": "MartialArtsSchool",
                        "name": "Superior Taekwondo"
                    },
                    "description": "High-intensity fitness classes incorporating martial arts movements for cardio and strength.",
                    "areaServed": "Helensville"
                }
            ]
        }
    </script>
    <script
        type="application/ld+json"
        set:html={JSON.stringify(pricingFaqSchema)}
    ></script>
    <main class="bg-deep-space-black min-h-screen pt-24 pb-12">
        <!-- React Pricing Component (Handles header and content internally now) -->
        <PricingSection client:load plans={plans} />

        <!-- Family discounts -->
        <div class="container mx-auto px-4 pb-12">
            <div class="max-w-4xl mx-auto relative z-10">
                <h2
                    class="text-white font-oswald font-bold uppercase tracking-wide text-2xl mb-2 text-center"
                >
                    Family discounts
                </h2>
                <p class="text-gray-400 font-body text-center mb-6">
                    Training together? Each extra family member gets a bigger discount.
                </p>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    {
                        familyDiscounts.map((tier) => (
                            <div class="bg-white/5 border border-white/10 rounded-xl p-6 text-center hover:border-blue-belt-end/50 transition-colors">
                                <p class="text-gray-400 font-body text-sm uppercase tracking-wider mb-2">
                                    {tier.member}
                                </p>
                                <p class="text-white font-oswald font-black text-2xl uppercase">
                                    {tier.discount}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>

        <!-- Membership policies -->
        <div class="container mx-auto px-4 pb-12">
            <div
                class="max-w-4xl mx-auto bg-white/5 border border-white/10 rounded-xl p-8 text-gray-400 font-body text-sm leading-relaxed relative z-10"
            >
                <h2
                    class="text-white font-oswald font-bold uppercase tracking-wide text-lg mb-4"
                >
                    Membership policies
                </h2>
                <ul class="list-disc pl-5 space-y-2">
                    {
                        policies.map((policy) => (
                            <li>
                                <strong class="text-gray-200">{policy.title}.</strong>{" "}
                                {policy.text}
                            </li>
                        ))
                    }
                    <li>
                        Weekly memberships are collected via direct debit.
                    </li>
                    <li>All training is at our Helensville dojang, 94 Mill Road.</li>
                </ul>
            </div>
        </div>

        <!-- Pricing FAQ (mirrors the FAQPage JSON-LD above) -->
        <div class="container mx-auto px-4 pb-24">
            <div class="max-w-4xl mx-auto relative z-10">
                <h2
                    class="text-white font-oswald font-bold uppercase tracking-wide text-2xl mb-6 text-center"
                >
                    Pricing questions
                </h2>
                <div class="space-y-4">
                    {
                        pricingFaqSchema.mainEntity.map((item) => (
                            <div class="bg-white/5 border border-white/10 rounded-xl p-6">
                                <h3 class="text-white font-oswald font-bold tracking-wide text-lg mb-2">
                                    {item.name}
                                </h3>
                                <p class="text-gray-400 font-body text-sm leading-relaxed">
                                    {item.acceptedAnswer.text}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </main>
    <Footer />
</Layout>
