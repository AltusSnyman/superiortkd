---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import PoomsaeSection from "../components/PoomsaeSection.tsx";

---

<Layout title="Poomsae Classes | Superior Taekwondo" description="Master Poomsae (patterns) with specialised technical training. Precision, balance and power for grading and elite competition preparation." canonical="https://superiortkd.co.nz/classes/poomsae/">
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Service",
            "serviceType": "Poomsae Classes",
            "provider": {
                "@type": "MartialArtsSchool",
                "name": "Superior Taekwondo"
            },
            "areaServed": {
                "@type": "City",
                "name": "Helensville"
            },
            "description": "Specialized Poomsae (patterns) training focusing on technique, precision, and presentation for grading and competition."
        }
    </script>
    <PoomsaeSection client:load />
    <Footer />
</Layout>
