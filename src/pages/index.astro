---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import Intro from "../components/Intro.astro";
import Olympian from "../components/Olympian.astro";
import WallOfFame from "../components/WallOfFame.astro";
import Reviews from "../components/Reviews.astro";
import ReadyToTrain from "../components/ReadyToTrain.astro";
import LatestNews from "../components/LatestNews.astro";
import Footer from "../components/Footer.astro";
import ScheduleGrid from "../components/ScheduleGrid.astro";
import Button from "../components/Button.astro";
import ClassFinder from "../components/ClassFinder.astro";

// Single source of truth for the homepage FAQ: rendered visibly in the
// "Common questions" section below AND emitted as the FAQPage schema, so the
// two can never drift apart.
const homepageFaqItems = [
	{
		question: "Where is Superior Taekwondo located?",
		answer: "Superior Taekwondo trains at one dojang, 94 Mill Road, Helensville 0875, in North West Auckland. Families travel to us from Kumeū, Huapai, Waimauku, Kaukapakapa, Riverhead and Westgate.",
	},
	{
		question: "Can I try a class before joining Superior Taekwondo?",
		answer: "Yes. Contact us to arrange a free trial class. We welcome students of all ages and experience levels to come and experience training before committing to a membership.",
	},
	{
		question: "Who is the head instructor at Superior Taekwondo?",
		answer: "Head instructor Andrea Kilday is a 2016 Rio Olympian, Oceania Gold Medallist, and 3rd Dan Black Belt. She brings elite-level technical knowledge and real Olympic competition experience directly to every class at Superior Taekwondo.",
	},
	{
		question: "What age can children start Taekwondo at Superior Taekwondo?",
		answer: "Children can start from age 4 in our Tiny Tigers programme. This class builds confidence, coordination, and discipline through age-appropriate Taekwondo fundamentals in a fun, structured environment.",
	},
	{
		question: "How long does it take to get a Black Belt in Taekwondo?",
		answer: "The average journey to 1st Dan Black Belt at Superior Taekwondo takes 3–5 years of consistent training. Progress depends on attendance, individual development, and readiness at each grading stage. Our structured curriculum ensures every student advances at the right pace.",
	},
	{
		question: "What age is best to start Taekwondo?",
		answer: "Tiny Tigers starts from age 4, and that's the earliest age we recommend. Older kids, teens and adults are welcome to start at any age — there's no upper limit, and everyone trains in a class suited to their age group.",
	},
	{
		question: "Taekwondo vs karate: what is the difference?",
		answer: "Taekwondo is a Korean martial art known for its kicking techniques, and it's an Olympic sport with sparring and poomsae (patterns) under World Taekwondo (WT) rules. Karate began in Japan and Okinawa and uses more hand strikes. Both build discipline and fitness — Superior Taekwondo teaches WT taekwondo, and we wouldn't say one is better than the other.",
	},
];

const homepageFaqSchema = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: homepageFaqItems.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.answer,
		},
	})),
});

const websiteSchema = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Superior Taekwondo",
	url: "https://superiortkd.co.nz",
	description:
		"New Zealand's premier World Taekwondo (WT) club in North West Auckland.",
	potentialAction: {
		"@type": "SearchAction",
		target: {
			"@type": "EntryPoint",
			urlTemplate:
				"https://superiortkd.co.nz/blog?q={search_term_string}",
		},
		"query-input": "required name=search_term_string",
	},
});

const homepageHeadContent = [
	`<script type="application/ld+json">${homepageFaqSchema}<\/script>`,
	`<script type="application/ld+json">${websiteSchema}<\/script>`,
].join("");
---

<Layout
	title="Taekwondo Classes North West Auckland | Superior Taekwondo"
	description="Olympian-coached Taekwondo for kids from 4, teens and adults at our Helensville dojang, North West Auckland. Free trial class. Memberships from $30 a week."
	headContent={homepageHeadContent}
>
	<main class="overflow-x-hidden">
		<Hero />
		<TrustBar />
		<Intro />
		<Olympian />

		<section id="schedule" class="py-24 bg-deep-space-black">
			<div class="container mx-auto px-4">
				<div class="text-center max-w-2xl mx-auto mb-12">
					<h2
						class="text-4xl md:text-5xl font-black font-oswald uppercase text-white mb-4"
					>
						Class times
					</h2>
					<p class="text-gray-400 text-lg">
						Six days a week at 94 Mill Road, Helensville. Your
						first class is free.
					</p>
				</div>

				<ScheduleGrid />

				<div class="flex justify-center mt-10">
					<Button href="/contact/#trial" variant="primary"
						>Book a free trial</Button
					>
				</div>
			</div>
		</section>

		<section class="py-24 bg-black">
			<div class="container mx-auto px-4">
				<ClassFinder />
			</div>
		</section>

		<WallOfFame />
		<Reviews />
		<LatestNews />

		<section class="py-24 bg-deep-space-black">
			<div class="container mx-auto px-4">
				<h2
					class="text-3xl md:text-4xl font-black font-oswald uppercase text-white text-center mb-12"
				>
					Common questions
				</h2>
				<div class="max-w-3xl mx-auto space-y-6">
					{
						homepageFaqItems.map((item) => (
							<div class="border-b border-white/10 pb-6">
								<h3 class="text-lg font-bold text-white mb-2">
									{item.question}
								</h3>
								<p class="text-gray-400">{item.answer}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<ReadyToTrain />
		<Footer />
	</main>
</Layout>
