---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import Intro from "../components/Intro.astro";
import Olympian from "../components/Olympian.astro";
import WallOfFame from "../components/WallOfFame.astro";
import Reviews from "../components/Reviews.astro";
import ReadyToTrain from "../components/ReadyToTrain.astro";
import LatestNews from "../components/LatestNews.astro";
import Footer from "../components/Footer.astro";
import ScheduleGrid from "../components/ScheduleGrid.astro";
import Button from "../components/Button.astro";
import ClassFinder from "../components/ClassFinder.astro";

const homepageFaqSchema = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "Where is Superior Taekwondo located?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "Superior Taekwondo trains at one dojang, 94 Mill Road, Helensville 0875, in North West Auckland. Families travel to us from Kumeū, Huapai, Waimauku, Kaukapakapa, Riverhead and Westgate.",
			},
		},
		{
			"@type": "Question",
			name: "Can I try a class before joining Superior Taekwondo?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "Yes. Contact us to arrange a free trial class. We welcome students of all ages and experience levels to come and experience training before committing to a membership.",
			},
		},
		{
			"@type": "Question",
			name: "Who is the head instructor at Superior Taekwondo?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "Head instructor Andrea Kilday is a 2016 Rio Olympian, Oceania Gold Medallist, and 3rd Dan Black Belt. She brings elite-level technical knowledge and real Olympic competition experience directly to every class at Superior Taekwondo.",
			},
		},
		{
			"@type": "Question",
			name: "What age can children start Taekwondo at Superior Taekwondo?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "Children can start from age 4 in our Tiny Tigers programme. This class builds confidence, coordination, and discipline through age-appropriate Taekwondo fundamentals in a fun, structured environment.",
			},
		},
		{
			"@type": "Question",
			name: "How long does it take to get a Black Belt in Taekwondo?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "The average journey to 1st Dan Black Belt at Superior Taekwondo takes 3–5 years of consistent training. Progress depends on attendance, individual development, and readiness at each grading stage. Our structured curriculum ensures every student advances at the right pace.",
			},
		},
	],
});

const websiteSchema = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Superior Taekwondo",
	url: "https://superiortkd.co.nz",
	description:
		"New Zealand's premier World Taekwondo (WT) club in North West Auckland.",
	potentialAction: {
		"@type": "SearchAction",
		target: {
			"@type": "EntryPoint",
			urlTemplate:
				"https://superiortkd.co.nz/blog?q={search_term_string}",
		},
		"query-input": "required name=search_term_string",
	},
});

const homepageHeadContent = [
	`<script type="application/ld+json">${homepageFaqSchema}<\/script>`,
	`<script type="application/ld+json">${websiteSchema}<\/script>`,
].join("");
---

<Layout
	title="Taekwondo Classes North West Auckland | Superior Taekwondo"
	description="Olympian-coached Taekwondo for kids from 4, teens and adults at our Helensville dojang, North West Auckland. Free trial class. Memberships from $30 a week."
	headContent={homepageHeadContent}
>
	<main class="overflow-x-hidden">
		<Hero />
		<TrustBar />
		<Intro />
		<Olympian />

		<section id="schedule" class="py-24 bg-deep-space-black">
			<div class="container mx-auto px-4">
				<div class="text-center max-w-2xl mx-auto mb-12">
					<h2
						class="text-4xl md:text-5xl font-black font-oswald uppercase text-white mb-4"
					>
						Class times
					</h2>
					<p class="text-gray-400 text-lg">
						Six days a week at 94 Mill Road, Helensville. Your
						first class is free.
					</p>
				</div>

				<ScheduleGrid />

				<div class="flex justify-center mt-10">
					<Button href="/contact/#trial" variant="primary"
						>Book a free trial</Button
					>
				</div>
			</div>
		</section>

		<section class="py-24 bg-black">
			<div class="container mx-auto px-4">
				<ClassFinder />
			</div>
		</section>

		<WallOfFame />
		<Reviews />
		<LatestNews />
		<ReadyToTrain />
		<Footer />
	</main>
</Layout>
