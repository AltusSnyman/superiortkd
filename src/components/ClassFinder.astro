---
// "Which class for my child" lookup: age band -> GymDesk class name -> days/times ->
// what happens / price. Data lives in src/data/ageTiers.ts (verbatim copy, do not
// reword here). No props are required — every prop below is optional so this can be
// dropped into any page with no arguments.
import Button from "./Button.astro";
import { ageTiers } from "../data/ageTiers";

interface Props {
	heading?: string;
	subheading?: string;
	headingLevel?: "h2" | "h3";
}

const {
	heading = "Which class is right for you?",
	subheading = "Every class runs at 94 Mill Road, Helensville. Your first one is free.",
	headingLevel = "h2",
} = Astro.props;

const Heading = headingLevel;
---

<div class="w-full">
	<div class="text-center max-w-2xl mx-auto mb-10">
		<Heading
			class="text-3xl md:text-4xl font-black font-oswald uppercase text-white mb-4"
		>
			{heading}
		</Heading>
		<p class="text-gray-400 text-lg">{subheading}</p>
	</div>

	<!-- Desktop / tablet: real table -->
	<div class="hidden md:block overflow-x-auto">
		<table class="w-full text-left border-collapse">
			<caption class="sr-only">
				Which Taekwondo class to choose by age, with GymDesk class name, days and times, and price.
			</caption>
			<thead>
				<tr class="border-b border-white/10">
					<th scope="col" class="p-4 font-bold text-white uppercase tracking-wider text-sm font-oswald">
						Age
					</th>
					<th scope="col" class="p-4 font-bold text-blue-belt-end uppercase tracking-wider text-sm font-oswald">
						Class
					</th>
					<th scope="col" class="p-4 font-bold text-white uppercase tracking-wider text-sm font-oswald">
						Days / times
					</th>
					<th scope="col" class="p-4 font-bold text-white uppercase tracking-wider text-sm font-oswald">
						What happens
					</th>
				</tr>
			</thead>
			<tbody>
				{
					ageTiers.map((row) => (
						<tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
							<th scope="row" class="p-4 font-bold text-white align-top whitespace-nowrap">
								{row.ageBand}
							</th>
							<td class="p-4 text-blue-belt-end align-top">{row.className}</td>
							<td class="p-4 text-gray-300 align-top">{row.schedule}</td>
							<td class="p-4 text-gray-400 align-top">{row.details}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	<!-- Phone: stacked cards -->
	<div class="md:hidden flex flex-col gap-4">
		{
			ageTiers.map((row) => (
				<div class="p-4 bg-white/5 border border-white/10 rounded-sm">
					<div class="font-oswald font-bold uppercase tracking-wider text-sm text-white mb-1">
						{row.ageBand}
					</div>
					<div class="text-blue-belt-end font-oswald font-bold mb-2">
						{row.className}
					</div>
					<div class="text-xs font-bold text-gray-300 mb-2 break-words">
						{row.schedule}
					</div>
					<div class="text-sm text-gray-400 leading-snug">{row.details}</div>
				</div>
			))
		}
	</div>

	<div class="text-center mt-10">
		<Button href="/contact/#trial" variant="primary">Book a free trial</Button>
	</div>
</div>
