---
import Button from "./Button.astro";

interface Props {
    title: string;
    subtitle?: string;
    image?: string;
}

const { title, subtitle, image = "/images/hero-poster.webp" } = Astro.props;
---

<section
    class="relative w-full min-h-[max(500px,60svh)] overflow-hidden flex items-center justify-center bg-deep-space-black py-28 md:py-32"
    id="hero"
>
    <!-- Image Background -->
    <div class="absolute inset-0 z-0 select-none pointer-events-none">
        <img
            src={image}
            alt={title}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover opacity-50 mix-blend-overlay"
        />
        <div
            class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-deep-space-black"
        >
        </div>
    </div>

    <!-- CSS Glow Background Layer (Overlay) — pure CSS, no JS -->
    <div
        class="absolute inset-0 z-0 opacity-60 mix-blend-plus-lighter pointer-events-none hidden md:block hero-css-glow"
        aria-hidden="true"
    >
    </div>

    <div
        class="relative z-10 text-center px-4 max-w-5xl mx-auto flex flex-col items-center gap-6"
    >
        <h1
            class="text-4xl md:text-6xl lg:text-8xl font-black font-oswald tracking-tighter text-white drop-shadow-2xl uppercase leading-none opacity-0 animate-fade-in [animation-delay:200ms] [animation-fill-mode:forwards]"
        >
            {title}
        </h1>

        {
            subtitle && (
                <h2 class="text-lg md:text-2xl font-bold text-white max-w-3xl opacity-0 animate-slide-up [animation-delay:400ms] [animation-fill-mode:forwards] tracking-wide drop-shadow-lg text-shadow-sm">
                    {subtitle}
                </h2>
            )
        }

        <div
            class="mt-8 opacity-0 animate-slide-up [animation-delay:600ms] [animation-fill-mode:forwards] flex gap-4"
        >
            <Button href="/contact/#trial" variant="primary">Book a free trial</Button>
            <Button href="/classes/" variant="secondary">See class times</Button>
        </div>
    </div>
</section>

<style>
    .hero-css-glow {
        background:
            radial-gradient(
                circle at 30% 25%,
                rgba(0, 229, 255, 0.35),
                transparent 55%
            ),
            radial-gradient(
                circle at 75% 75%,
                rgba(0, 31, 63, 0.65),
                transparent 60%
            ),
            var(--color-deep-space-black, #000000);
    }

    .hero-css-glow::after {
        content: "";
        position: absolute;
        inset: -20%;
        background: radial-gradient(
            circle at 50% 50%,
            rgba(0, 229, 255, 0.25),
            transparent 60%
        );
        filter: blur(60px);
        animation: hero-glow-drift 12s ease-in-out infinite;
    }

    @keyframes hero-glow-drift {
        0%,
        100% {
            transform: scale(1) translate(0, 0);
            opacity: 0.6;
        }
        50% {
            transform: scale(1.15) translate(3%, -3%);
            opacity: 0.9;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-css-glow::after {
            animation: none;
        }
    }
</style>
