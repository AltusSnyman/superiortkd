---
import { schedule, SCHEDULE_AS_OF, GYMDESK_SCHEDULE_URL, type ScheduleDay, type ClassSlot } from "../data/schedule";

interface Props {
	filter?: string;
	title?: string;
	heading?: "h2" | "h3";
}

const { filter, title, heading = "h2" } = Astro.props;
const Heading = heading;

const days: ScheduleDay[] = filter
	? schedule
			.map((day) => ({
				...day,
				slots: day.slots.filter((slot: ClassSlot) =>
					slot.name.toLowerCase().includes(filter.toLowerCase()),
				),
			}))
			.filter((day) => day.slots.length > 0)
	: schedule;
---

<div class="w-full">
	{title && (
		<Heading class="text-2xl md:text-3xl font-bold font-oswald text-white uppercase mb-6 border-l-4 border-blue-belt-end pl-4">
			{title}
		</Heading>
	)}

	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-7 gap-3 lg:gap-2">
		{
			days.map((day) => (
				<div class="flex flex-col gap-2 min-w-0">
					<div class="p-2 text-center font-oswald font-bold uppercase tracking-wider text-sm bg-blue-belt-start text-white border border-white/10 rounded-sm">
						{day.day}
					</div>
					<div class="flex flex-col gap-2">
						{day.slots.length > 0 ? (
							day.slots.map((slot) => (
								<div class="p-3 bg-white/5 border border-white/10 rounded-sm text-center hover:border-blue-belt-end/50 hover:bg-white/10 transition-colors duration-300">
									<div class="text-xs font-bold text-blue-belt-end font-oswald tracking-wide mb-1 break-words">
										{slot.time}
									</div>
									<div class="text-xs md:text-sm text-gray-200 leading-snug break-words">
										{slot.name}
									</div>
								</div>
							))
						) : (
							<div class="p-3 bg-black/40 border border-white/5 rounded-sm text-center text-gray-600 text-xs">
								No class
							</div>
						)}
					</div>
				</div>
			))
		}
	</div>

	<div class="mt-6 text-sm text-gray-400 text-center space-y-1">
		<p>All classes coached by Andrea Kilday and the Superior team.</p>
		<p>
			Timetable current as of {SCHEDULE_AS_OF}; book on{" "}
			<a
				href={GYMDESK_SCHEDULE_URL}
				target="_blank"
				rel="noopener"
				class="text-blue-belt-end hover:underline"
			>
				GymDesk
			</a>
		</p>
	</div>
</div>
