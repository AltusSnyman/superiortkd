---
const posts = [
    {
        title: "After-School Activities in Kumeū: Is Taekwondo Right for Your Child?",
        slug: "after-school-activities-kumeu",
        excerpt:
            "Weighing after-school options in Kumeū and Huapai? What Taekwondo gives kids from age 4, and how the Helensville dojang fits a school run.",
        category: "For Parents",
        imageSrc: "/images/blog/after-school-activities-kumeu-hero-1600.webp",
        imageAlt:
            "A quiet New Zealand suburban street in the late afternoon with school bags on a porch bench",
    },
    {
        title: "Kids' Martial Arts in West Auckland: How to Choose a Club",
        slug: "kids-martial-arts-west-auckland",
        excerpt:
            "Karate, Taekwondo or MMA for your child? A parent's guide to what each teaches and what to look for in a coach.",
        category: "For Parents",
        imageSrc: "/images/blog/kids-martial-arts-west-auckland-hero-1600.webp",
        imageAlt:
            "A row of coloured martial-arts belts, white through to black, folded on a wooden bench",
    },
    {
        title: "Women's Self-Defence Classes in Auckland",
        slug: "womens-self-defence-classes-auckland",
        excerpt:
            "Why regular training beats a one-off workshop, and what Taekwondo teaches that actually transfers.",
        category: "Self-Defence",
        imageSrc: "/images/blog/womens-self-defence-classes-auckland-hero-1600.webp",
        imageAlt:
            "Red kick pads and a water bottle on a blue mat at the edge of an empty training hall",
    },
];
---

<section class="py-24 bg-black relative overflow-hidden">
    <!-- Background Decor -->
    <div
        class="absolute top-0 right-0 w-96 h-96 bg-blue-belt-end/5 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2 pointer-events-none"
    >
    </div>

    <div class="container mx-auto px-4 relative z-10">
        <div class="text-center mb-16">
            <p
                class="text-blue-belt-end font-bold tracking-widest uppercase text-sm mb-4"
            >
                The Knowledge Hub
            </p>
            <h2
                class="text-4xl md:text-5xl font-black font-oswald text-white uppercase tracking-tighter leading-none"
            >
                Latest <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-blue-belt-start to-blue-belt-end"
                    >Insights</span
                >
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
                posts.map((post) => (
                    <a
                        href={`/blog/${post.slug}/`}
                        class="group block bg-white/5 border border-white/10 rounded-2xl overflow-hidden hover:border-blue-belt-end/50 hover:bg-white/10 transition-all duration-300 transform hover:-translate-y-2"
                    >
                        <div class="h-48 bg-gradient-to-br from-gray-800 to-black relative overflow-hidden">
                            <img
                                src={post.imageSrc}
                                alt={post.imageAlt}
                                width={403}
                                height={192}
                                loading="lazy"
                                decoding="async"
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                            />
                            <div class="absolute inset-0 bg-blue-belt-end/10 group-hover:bg-blue-belt-end/20 transition-colors pointer-events-none" />
                            <span class="absolute top-4 left-4 bg-blue-belt-end text-black text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider z-10">
                                {post.category}
                            </span>
                        </div>

                        <div class="p-6">
                            <h3 class="text-xl font-bold font-oswald text-white mb-3 group-hover:text-blue-belt-end transition-colors leading-tight">
                                {post.title}
                            </h3>
                            <p class="text-gray-400 text-sm mb-4 line-clamp-3">
                                {post.excerpt}
                            </p>
                            <span class="text-blue-belt-end text-sm font-bold uppercase flex items-center gap-2">
                                Read Article{" "}
                                <span class="group-hover:translate-x-1 transition-transform">
                                    &rarr;
                                </span>
                            </span>
                        </div>
                    </a>
                ))
            }
        </div>

        <div class="mt-12 text-center">
            <a
                href="/blog/"
                class="inline-block border border-white/20 hover:border-blue-belt-end text-white hover:text-blue-belt-end font-bold font-oswald uppercase tracking-widest py-3 px-8 rounded transition-all duration-300"
            >
                View All Articles
            </a>
        </div>
    </div>
</section>


