---
import Button from "./Button.astro";
---

<section
    class="relative w-full min-h-[max(640px,100svh)] overflow-hidden flex items-center justify-center bg-deep-space-black py-28 md:py-32"
    id="hero"
>
    <!-- Looping video background with poster fallback -->
    <div
        class="absolute inset-0 z-0 select-none pointer-events-none bg-cover bg-center bg-no-repeat opacity-60 mix-blend-screen"
        style="background-image: url('/images/hero-poster.webp');"
    >
        <video
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
            poster="/images/hero-poster.webp"
            class="w-full h-full object-cover"
            aria-hidden="true"
        >
            <source src="/videos/hero.mp4" type="video/mp4" />
        </video>
        <div
            class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/80"
        >
        </div>
    </div>

    <!-- CSS Glow Background Layer — desktop only, pure CSS (no JS) -->
    <div
        class="absolute inset-0 z-0 opacity-80 mix-blend-plus-lighter hidden md:block pointer-events-none hero-css-glow"
        aria-hidden="true"
    >
    </div>

    <div
        class="relative z-10 text-center px-4 max-w-5xl mx-auto flex flex-col items-center gap-6"
    >
        <h1
            class="text-5xl md:text-7xl lg:text-[5.5rem] font-black font-oswald tracking-tighter text-white drop-shadow-2xl uppercase leading-none opacity-0 animate-fade-in [animation-delay:200ms] [animation-fill-mode:forwards]"
        >
            Taekwondo for kids, teens and adults, coached by an Olympian
        </h1>

        <h2
            class="text-lg md:text-2xl font-bold text-white max-w-2xl opacity-0 animate-slide-up [animation-delay:600ms] [animation-fill-mode:forwards] tracking-wide drop-shadow-[0_2px_2px_rgba(0,0,0,0.8)] [text-shadow:_1px_1px_0_rgb(0_0_0_/_100%)]"
        >
            One dojang at 94 Mill Road, Helensville, serving families across North West Auckland. Head coach Andrea Kilday competed at Rio 2016. Your first class is free.
        </h2>

        <div
            class="mt-8 flex flex-col sm:flex-row gap-4 items-center opacity-0 animate-slide-up [animation-delay:900ms] [animation-fill-mode:forwards]"
        >
            <Button href="/contact/#trial" variant="primary"
                >Book a free trial</Button
            >
            <Button href="#schedule" variant="secondary"
                >See class times</Button
            >
        </div>
    </div>

    <!-- Immersive Scroll Indicator -->
    <div
        class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce flex flex-col items-center gap-2 opacity-70"
    >
        <span
            class="text-xs font-oswald uppercase tracking-widest text-blue-gradient"
            >Scroll</span
        >
        <svg
            class="w-6 h-6 text-blue-belt-end"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
    </div>
</section>

<style>
    .hero-css-glow {
        background:
            radial-gradient(
                circle at 30% 25%,
                rgba(0, 229, 255, 0.35),
                transparent 55%
            ),
            radial-gradient(
                circle at 75% 75%,
                rgba(0, 31, 63, 0.65),
                transparent 60%
            ),
            var(--color-deep-space-black, #000000);
    }

    .hero-css-glow::after {
        content: "";
        position: absolute;
        inset: -20%;
        background: radial-gradient(
            circle at 50% 50%,
            rgba(0, 229, 255, 0.25),
            transparent 60%
        );
        filter: blur(60px);
        animation: hero-glow-drift 12s ease-in-out infinite;
    }

    @keyframes hero-glow-drift {
        0%,
        100% {
            transform: scale(1) translate(0, 0);
            opacity: 0.6;
        }
        50% {
            transform: scale(1.15) translate(3%, -3%);
            opacity: 0.9;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-css-glow::after {
            animation: none;
        }
    }
</style>
